{
  "routes": [
    {
      "src": "/sitemap-hacks\\.xml",
      "dest": "/api/sitemap-hacks"
    },
    {
      "src": "/",
      "dest": "/api/page"
    },
    {
      "src": "/feed\\.xml",
      "dest": "/api/feed"
    },
    {
      "src": "/ads\\.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/|assets/|rom-patcher-js/|webapp/|.*\\.[a-zA-Z0-9]+$).*)",
      "dest": "/api/page"
    }
  ],
  "functions": {
    "api/page.ts": {
      "includeFiles": "{dist,server-dist}/**",
      "maxDuration": 30
    },
    "api/sitemap-hacks.ts": {
      "maxDuration": 30
    },
    "api/feed.ts": {
      "maxDuration": 30
    }
  }
}
